mod {
    mkmailer {
        qualifier = mailer

        overview {
            template = EXT:mkmailer/mod1/templates/overview.html
        }

        functest {
            template = EXT:mkmailer/mod1/templates/queuefunc.html
            queue {
                name.wrap = -|-
            }
        }

        languagefiles {
            10 = EXT:mkmailer/Resources/Private/Language/Backend/locallang_mod.xlf
        }
    }
    web_list.table.tx_mkmailer_receiver.hideTable = 1
}

templates.dmk/mkmailer {
    10 = digedag/rn-base:Resources/Private/
}
